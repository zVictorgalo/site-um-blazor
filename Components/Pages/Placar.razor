@page "/placar"

<PageTitle>Placar</PageTitle>

<h1>Placar</h1>

<h2 class="placar">@pontos</h2>

<div class="botoes">
    <button @onclick="Somar">Somar 1 Ponto</button>
    <button @onclick="Subtrair">Subtrair 1 Ponto</button>
    <button @onclick="Zerar">Zerar Placar</button>
</div>

@code {
    private int pontos = 0;

    private void Somar()
    {
        pontos++;
    }

    private void Subtrair()
    {
        pontos--;

        if (pontos < 0)
        {
            pontos = 0;
        }
    }

    private void Zerar()
    {
        pontos = 0;
    }
}
